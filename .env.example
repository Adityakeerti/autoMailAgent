# Application Settings
DATABASE_URL=sqlite+aiosqlite:///./automail.db
STORAGE_BUCKET_URL=local://storage
STORAGE_ACCESS_KEY=local_key
STORAGE_SECRET_KEY=local_secret
JWT_SECRET=super-secret-jwt-key-change-in-production-12345
ENCRYPTION_KEY=32byte-base64-fernet-key-or-autogenerated

# ─────────────────────────────────────────────────
# Google OAuth2 — REQUIRED for Gmail login + sending
# ─────────────────────────────────────────────────
# How to get these:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project → Enable "Gmail API"
# 3. OAuth consent screen → External → Add scopes:
#      openid, email, profile, https://mail.google.com/
# 4. Credentials → Create OAuth 2.0 Client ID (Web Application)
# 5. Add Authorized Redirect URI:
#      Local:      http://127.0.0.1:8000/auth/google/callback
#      Production: https://yourdomain.com/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# LLM Providers (Multi-fallback support)
GROQ_API_KEY=gsk_xxx
OLLAMA_API_KEY=xxx
GEMINI_API_KEY=AQ.xxx
GITHUB_TOKEN=github_pat_xxx

# LinkedIn Scraping (optional shared cookie)
SHARED_LINKEDIN_COOKIE=
